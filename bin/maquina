#!/usr/bin/env bash
# bin/maquina — chama o núcleo instalado em ~/.maquina
MAQUINA_HOME="${MAQUINA_HOME:-$HOME/.maquina}"
export MAQUINA_HOME
PY="$MAQUINA_HOME/venv/bin/python"
if [ ! -x "$PY" ]; then
  echo "❌ A Máquina não está instalada direito. Rode o instalar.sh de novo." >&2
  exit 1
fi
# -I: ignora a pasta atual e PYTHONPATH (uma pasta "nucleo" do aluno não pode sobrepor a instalada)
exec "$PY" -I -c 'import sys, os; sys.path.insert(0, os.environ["MAQUINA_HOME"]); from nucleo.cli import main; sys.exit(main())' "$@"
